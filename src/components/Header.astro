---
import { NAV, SITE } from '../site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<header class="border-b border-line">
  <div class="max-w-3xl mx-auto px-5 sm:px-6 py-5 flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
    <a href="/" class="font-serif text-xl tracking-tight hover:text-accent transition-colors">{SITE.name}</a>
    <div class="flex items-center gap-4">
      <nav aria-label="Main">
        <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
          {NAV.filter((item) => item.href !== '/').map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="text-muted hover:text-fg transition-colors aria-[current=page]:text-fg aria-[current=page]:underline aria-[current=page]:decoration-accent aria-[current=page]:underline-offset-8"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
