---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<header class="mb-12">
  {eyebrow && <p class="text-sm uppercase tracking-widest text-accent mb-3">{eyebrow}</p>}
  <h1 class="font-serif text-4xl sm:text-5xl font-medium tracking-tight leading-tight">{title}</h1>
  {lead && <p class="mt-5 text-lg text-muted leading-relaxed max-w-2xl">{lead}</p>}
</header>
