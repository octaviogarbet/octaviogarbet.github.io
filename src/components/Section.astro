---
interface Props {
  title: string;
  intro?: string;
  id?: string;
}
const { title, intro, id } = Astro.props;
---

<section id={id} class="mt-16 first:mt-0">
  <h2 class="font-serif text-2xl font-medium tracking-tight">{title}</h2>
  {intro && <p class="mt-2 text-muted leading-relaxed">{intro}</p>}
  <div class="mt-8">
    <slot />
  </div>
</section>
