---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPublished } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getPublished('portfolio');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, role, stack, url, repo } = project.data;
---

<Base title={title} description={summary}>
  <article>
    <header class="mb-10">
      <a href="/portfolio" class="text-sm text-muted hover:text-fg transition-colors">← All projects</a>
      <h1 class="mt-6 font-serif text-4xl sm:text-5xl font-medium tracking-tight leading-tight">{title}</h1>
      <p class="mt-4 text-lg text-muted leading-relaxed">{summary}</p>
      <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-6 gap-y-1 text-sm">
        {role && <><dt class="text-muted">Role</dt><dd>{role}</dd></>}
        {stack.length > 0 && <><dt class="text-muted">Stack</dt><dd>{stack.join(', ')}</dd></>}
        {url && <><dt class="text-muted">Live</dt><dd><a href={url} target="_blank" rel="noopener noreferrer" class="underline decoration-accent underline-offset-4">{new URL(url).host}</a></dd></>}
        {repo && <><dt class="text-muted">Code</dt><dd><a href={repo} target="_blank" rel="noopener noreferrer" class="underline decoration-accent underline-offset-4">Repository</a></dd></>}
      </dl>
    </header>
    <div class="prose prose-lg max-w-none">
      <Content />
    </div>
  </article>
</Base>
