---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { getOrdered } from '../lib/content';

const experience = await Promise.all(
  (await getOrdered('experience')).map(async (job) => ({ job, ...(await render(job)) })),
);
const skills = await Promise.all(
  (await getOrdered('skills')).map(async (skill) => ({ skill, ...(await render(skill)) })),
);
---

<Base title="Resume" description="Resume of Octavio Garbarino, Software Development Team Lead and Engineering Manager.">
  <PageHeader
    eyebrow="Resume"
    title="Engineering Manager & Tech Lead"
    lead="10+ years in the IT industry, with deep knowledge of web technologies on both back-end and front-end. I focus on quality, on aligning projects with business needs, and on a healthy environment where people grow."
  />

  <div class="prose max-w-none mb-4">
    <p>
      I have a track record of guiding colleagues in their careers and building a knowledge-sharing culture that
      develops new leaders across the organization. My leadership role has grown to managing engineers across several
      teams. I'm also a presenter at conferences, meetups and internal events.
    </p>
  </div>

  <Section title="Experience" intro="The most relevant roles I've held in the software industry.">
    <ol class="relative border-l border-line ml-1.5 space-y-10">
      {experience.map(({ job, Content }) => (
        <li class="pl-6 relative">
          <span class="absolute -left-[5px] top-2 size-2.5 rounded-full bg-bg border-2 border-accent" aria-hidden="true" />
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-x-4">
            <h3 class="font-medium">
              {job.data.role} <span class="text-muted font-normal">· {job.data.company}</span>
            </h3>
            <span class="text-sm text-muted shrink-0">{job.data.period}</span>
          </div>
          <div class="prose max-w-none mt-2 text-[0.95rem]"><Content /></div>
        </li>
      ))}
    </ol>
  </Section>

  <Section title="Skills" intro="Experience across languages and frameworks, and across every stage of software development.">
    <dl class="grid sm:grid-cols-2 gap-x-10 gap-y-8">
      {skills.map(({ skill, Content }) => (
        <div>
          <dt class="font-medium">{skill.data.title}</dt>
          <dd class="prose prose-sm max-w-none mt-1"><Content /></dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section title="Education">
    <p class="leading-relaxed">
      Computer Engineering at Universidad de la República, Uruguay (63% of the degree completed).
    </p>
  </Section>
</Base>
