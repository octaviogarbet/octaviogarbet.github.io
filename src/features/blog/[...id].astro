---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPublished, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPublished('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <header class="mb-10">
      <a href="/blog" class="text-sm text-muted hover:text-fg transition-colors">← All posts</a>
      <h1 class="mt-6 font-serif text-4xl sm:text-5xl font-medium tracking-tight leading-tight">{post.data.title}</h1>
      <p class="mt-4 text-sm text-muted">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {post.data.tags.length > 0 && <span> · {post.data.tags.join(', ')}</span>}
      </p>
    </header>
    <div class="prose prose-lg max-w-none">
      <Content />
    </div>
  </article>
</Base>
